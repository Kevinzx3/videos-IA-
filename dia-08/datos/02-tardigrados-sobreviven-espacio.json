 "segmentos": [
  [
   0.0,
   5.84,
   "Este animal sobrevivió al espacio exterior sin traje. Y mide menos de un milímetro."
  ],
  [
   5.84,
   12.09,
   "Se llama tardígrado. Tiene ocho patitas con garras y camina como un osito lento."
  ],
  [
   12.09,
   15.0,
   "Por eso también los llaman osos de agua."
  ],
  [
   15.0,
   21.71,
   "Viven casi en cualquier parte: en el musgo de tu jardín, en el fondo del mar, en montañas heladas."
  ],
  [
   21.71,
   27.85,
   "Su superpoder: cuando las cosas se ponen feas, se secan por completo y se encogen como una bolita."
  ],
  [
   27.85,
   34.06,
   "En ese estado aguantan congelarse, hervir un rato, y dosis de radiación que matarían a una persona."
  ],
  [
   34.06,
   41.01,
   "En 2007, la Agencia Espacial Europea los mandó al espacio, a la intemperie, durante diez días."
  ],
  [
   41.01,
   46.03,
   "Al volver, muchos se rehidrataron… y siguieron con su vida como si nada."
  ],
  [
   46.03,
   48.89,
   "Algunos incluso tuvieron crías después del viaje."
  ],
  [
   48.89,
   50.77,
   "Ahora, el giro:"
  ],
  [
   50.77,
   55.88,
   "en 2019 una nave israelí que llevaba tardígrados se estrelló en la Luna."
  ],
  [
   55.88,
   59.92,
   "Nadie sabe si siguen allí, secos, esperando una gota de agua."
  ],
  [
   59.92,
   64.02,
   "¿Qué animal extremo explico después? Comenta y sígueme."
  ]
 ],
