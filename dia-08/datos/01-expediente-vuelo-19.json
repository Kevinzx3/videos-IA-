 "segmentos": [
  [
   0.0,
   8.0,
   "Expediente Misterio número uno: cinco aviones despegaron en 1945… y ninguno volvió."
  ],
  [
   8.0,
   15.35,
   "Fue el cinco de diciembre, en Florida. Un vuelo de entrenamiento de la Marina de Estados Unidos: el Vuelo 19."
  ],
  [
   15.35,
   18.88,
   "Cinco bombarderos Avenger, catorce tripulantes."
  ],
  [
   18.88,
   23.38,
   "A mitad del vuelo, el líder dijo por radio que sus brújulas no funcionaban."
  ],
  [
   23.38,
   28.95,
   "Creía que estaba sobre los Cayos de Florida… pero probablemente estaba mucho más al norte."
  ],
  [
   28.95,
   34.86,
   "Volaron en círculos, se hizo de noche, el mar se puso bravo y el combustible se acababa."
  ],
  [
   34.86,
   38.7,
   "Lo último que se escuchó fue que iban a amerizar todos juntos."
  ],
  [
   38.7,
   40.9,
   "Nunca se encontraron restos."
  ],
  [
   40.9,
   42.35,
   "Ahora, el giro:"
  ],
  [
   42.35,
   48.96,
   "esa misma noche despegó un hidroavión de rescate, con trece hombres a bordo… y también desapareció."
  ],
  [
   48.96,
   53.93,
   "Un barco cercano vio una explosión en el cielo, y una mancha de combustible en el agua."
  ],
  [
   53.93,
   61.5,
   "La Marina terminó escribiendo: causas desconocidas. Y así nació la leyenda del Triángulo de las Bermudas."
  ],
  [
   61.5,
   66.02,
   "¿Tú qué crees que pasó? Comenta y sígueme para el siguiente expediente."
  ]
 ],
