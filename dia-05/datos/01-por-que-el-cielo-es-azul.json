 "segmentos": [
  [
   0.0,
   3.39,
   "¿Por qué el cielo es azul, si la luz del Sol es blanca?"
  ],
  [
   3.39,
   7.16,
   "Porque la luz blanca es una mezcla de todos los colores."
  ],
  [
   7.16,
   10.76,
   "Al entrar en la atmósfera, choca con las moléculas del aire,"
  ],
  [
   10.76,
   15.99,
   "y esas moléculas desvían la luz azul unas cinco o seis veces más que la roja."
  ],
  [
   15.99,
   18.32,
   "Se llama dispersión de Rayleigh."
  ],
  [
   18.32,
   23.49,
   "Resultado: la luz azul rebota por todo el cielo y nos llega desde todas partes."
  ],
  [
   23.49,
   30.89,
   "¿Y los atardeceres naranjas? Al caer el sol, la luz cruza mucho más aire y el azul se pierde por el camino."
  ],
  [
   30.89,
   33.58,
   "Solo nos llegan los rojos y los naranjas."
  ],
  [
   33.58,
   35.21,
   "Ahora, el giro:"
  ],
  [
   35.21,
   39.54,
   "en Marte es al revés. De día, el cielo es color caramelo por el polvo,"
  ],
  [
   39.54,
   41.84,
   "y los atardeceres son azules."
  ],
  [
   41.84,
   45.16,
   "¿Qué cielo prefieres? Comenta y sígueme."
  ]
 ],
