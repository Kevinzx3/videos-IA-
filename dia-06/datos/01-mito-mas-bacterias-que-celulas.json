 "segmentos": [
  [
   0.0,
   3.76,
   "Seguro te dijeron que tienes diez veces más bacterias que células humanas."
  ],
  [
   3.76,
   6.43,
   "Pues ese dato está mal."
  ],
  [
   6.43,
   11.68,
   "Salió de una estimación de 1972, y se repitió durante décadas."
  ],
  [
   11.68,
   17.84,
   "En 2016, unos científicos del Instituto Weizmann, en Israel, volvieron a contar."
  ],
  [
   17.84,
   21.39,
   "Resultado: unos treinta billones de células humanas,"
  ],
  [
   21.39,
   23.87,
   "y unos treinta y ocho billones de bacterias."
  ],
  [
   23.87,
   28.82,
   "O sea, más o menos una bacteria por cada célula. No diez."
  ],
  [
   28.82,
   33.22,
   "Y casi todas viven en tu intestino grueso, ayudándote a digerir."
  ],
  [
   33.22,
   34.63,
   "Ahora, el giro:"
  ],
  [
   34.63,
   39.22,
   "cerca del noventa por ciento de tus células son glóbulos rojos y plaquetas."
  ],
  [
   39.22,
   44.28,
   "Y como las bacterias son tan pequeñas, todas juntas pesan unos doscientos gramos."
  ],
  [
   44.28,
   48.51,
   "¿Qué dato de tu cuerpo te sorprendió más? Comenta y sígueme."
  ]
