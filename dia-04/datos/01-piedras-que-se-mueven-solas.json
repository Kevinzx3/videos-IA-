 ],
 "segmentos": [
  [
   0.0,
   3.72,
   "En el desierto más caliente de Estados Unidos hay piedras que se mueven solas."
  ],
  [
   3.72,
   9.44,
   "Es Racetrack Playa, en el Valle de la Muerte: un lago seco, plano como una mesa."
  ],
  [
   9.44,
   14.6,
   "Sobre él hay rocas, algunas de decenas de kilos, y detrás de cada una, un rastro."
  ],
  [
   14.6,
   19.78,
   "Surcos larguísimos, curvos, en zigzag. Pero nadie había visto nunca una piedra moverse."
  ],
  [
   19.78,
   26.11,
   "Durante décadas hubo teorías: vientos huracanados, capas de algas resbaladizas, y hasta extraterrestres."
  ],
  [
   26.11,
   29.99,
   "Hasta que unos científicos llenaron el lago de cámaras y de piedras con GPS."
  ],
  [
   29.99,
   33.54,
   "Y en diciembre de 2013, por fin, las grabaron moviéndose."
  ],
  [
   33.54,
   37.71,
   "El secreto: en invierno el lago se llena de un poco de agua, que de noche se congela."
  ],
  [
   37.71,
   42.23,
   "Al salir el sol, ese hielo se rompe en placas finísimas, de pocos milímetros."
  ],
  [
   42.23,
   45.5,
   "Y una brisa suave empuja las placas, que arrastran las piedras."
  ],
  [
   45.5,
   46.88,
   "Ahora, el giro:"
  ],
  [
   46.88,
   53.05,
   "se mueven a solo dos a seis metros por minuto. Tan despacio que, si estuvieras allí, casi ni lo notarías."
  ],
  [
   53.05,
   58.5,
   "El gran misterio era hielo y paciencia. ¿Qué otro misterio resuelvo? Comenta y sígueme."
  ]
 ],
