 "segmentos": [
  [
   0.0,
   4.33,
   "En Venus, un día dura más que un año. Y no, no es un error."
  ],
  [
   4.33,
   9.85,
   "Venus tarda unos doscientos veinticinco días terrestres en dar la vuelta al Sol: ese es su año."
  ],
  [
   9.85,
   14.05,
   "Pero dar una vuelta sobre sí mismo le cuesta doscientos cuarenta y tres días."
  ],
  [
   14.05,
   18.46,
   "O sea, gira tan lento que una sola vuelta tarda más que su año entero."
  ],
  [
   18.46,
   23.07,
   "Si vivieras allí, podrías cumplir años antes de terminar un solo día."
  ],
  [
   23.07,
   27.46,
   "Y hay más: Venus gira al revés que casi todos los planetas."
  ],
  [
   27.46,
   30.27,
   "Allí, el Sol sale por el oeste y se pone por el este."
  ],
  [
   30.27,
   37.38,
   "¿Por qué? Nadie lo sabe seguro. Quizá un choque gigante en su pasado, o el empuje de su atmósfera, tan espesa."
  ],
  [
   37.38,
   38.77,
   "Ahora, el giro:"
  ],
  [
   38.77,
   44.37,
   "si te quedas quieto en Venus mirando el cielo, verás amanecer más o menos cada ciento diecisiete días."
  ],
  [
   44.37,
   49.91,
   "Porque al girar al revés mientras avanza en su órbita, el Sol vuelve a salir antes de que complete la vuelta."
  ],
  [
   49.91,
   54.66,
   "Así que su día solar es más corto que su año… pero sigue siendo eterno."
  ],
  [
   54.66,
   58.5,
   "¿Qué planeta quieres que explique ahora? Comenta y sígueme."
  ]
 ],
