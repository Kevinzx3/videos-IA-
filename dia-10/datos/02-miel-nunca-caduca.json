 "segmentos": [
  [
   0.0,
   6.49,
   "Hay un alimento que, guardado bien cerrado, prácticamente nunca se echa a perder: la miel."
  ],
  [
   6.49,
   13.6,
   "Arqueólogos han encontrado tarros de miel en tumbas del antiguo Egipto, de miles de años… y en buen estado."
  ],
  [
   13.6,
   16.7,
   "¿Cómo es posible? Por tres trucos químicos."
  ],
  [
   16.7,
   20.25,
   "Primero: tiene muy poquita agua y muchísimo azúcar."
  ],
  [
   20.25,
   24.51,
   "Si una bacteria cae en la miel, la miel le chupa el agua y la bacteria se seca."
  ],
  [
   24.51,
   30.77,
   "Segundo: es bastante ácida, y a casi ningún microbio le gusta vivir en un ambiente así."
  ],
  [
   30.77,
   37.87,
   "Tercero: las abejas le añaden una enzima que produce un poquito de peróxido de hidrógeno, como el agua oxigenada."
  ],
  [
   37.87,
   42.56,
   "Y todo eso dentro de un tarro cerrado, para que no absorba humedad del aire."
  ],
  [
   42.56,
   44.14,
   "Ahora, el giro:"
  ],
  [
   44.14,
   48.81,
   "si tu miel se pone dura y blanca, no está mala: solo se cristalizó."
  ],
  [
   48.81,
   52.92,
   "Ponla al baño maría, con calor suave, y vuelve a quedar líquida."
  ],
  [
   52.92,
   56.74,
   "Así que no la tires: esa miel puede durarte más que tú."
  ],
  [
   56.74,
   60.91,
   "¿Qué alimento quieres que explique después? Comenta y sígueme."
  ]
 ],
