 "segmentos": [
  [
   0.0,
   6.36,
   "En 1872 encontraron un barco navegando solo en medio del Atlántico. Sin nadie a bordo."
  ],
  [
   6.36,
   13.35,
   "Era el Mary Celeste, y lo vio otro barco, el Dei Gratia, a cientos de kilómetros de las islas Azores."
  ],
  [
   13.35,
   18.73,
   "Subieron, y no había nadie: ni el capitán, ni su familia, ni la tripulación."
  ],
  [
   18.73,
   21.35,
   "Diez personas, desaparecidas."
  ],
  [
   21.35,
   25.36,
   "Pero el barco estaba en buen estado, con comida y agua para meses."
  ],
  [
   25.36,
   29.76,
   "Y la carga seguía ahí: unos mil setecientos barriles de alcohol."
  ],
  [
   29.76,
   33.26,
   "Solo faltaba una cosa: el bote salvavidas."
  ],
  [
   33.26,
   34.74,
   "Ahora, el giro:"
  ],
  [
   34.74,
   44.41,
   "al descargar, nueve barriles estaban vacíos. Una teoría: temieron una explosión por los vapores y huyeron al bote, que nunca apareció."
  ],
  [
   44.41,
   52.94,
   "Y detalles famosos, como la comida aún caliente en la mesa, salen de un cuento de Arthur Conan Doyle, el creador de Sherlock Holmes."
  ],
  [
   52.94,
   56.73,
   "¿Tú qué crees que pasó? Comenta y sígueme para más misterios."
  ]
 ],
