 "segmentos": [
  [
   0.0,
   7.72,
   "En 1997, el océano Pacífico hizo un sonido tan fuerte que lo captaron micrófonos a miles de kilómetros."
  ],
  [
   7.72,
   9.64,
   "Lo llamaron el Bloop."
  ],
  [
   9.64,
   17.58,
   "La agencia del océano de Estados Unidos, la NOAA, escuchaba el mar con hidrófonos: micrófonos submarinos."
  ],
  [
   17.58,
   22.38,
   "Algunos estaban a más de tres mil kilómetros de distancia, y todos lo oyeron."
  ],
  [
   22.38,
   26.16,
   "Era grave, subía de tono y duraba cerca de un minuto."
  ],
  [
   26.16,
   31.29,
   "Internet se volvió loco: ¿un animal gigante? ¿Un monstruo marino?"
  ],
  [
   31.29,
   35.46,
   "Porque para sonar así, tendría que ser más grande que una ballena azul."
  ],
  [
   35.46,
   36.79,
   "Ahora, el giro:"
  ],
  [
   36.79,
   42.57,
   "años después, la NOAA encontró al culpable: un iceberg rompiéndose en la Antártida."
  ],
  [
   42.57,
   47.97,
   "Un terremoto de hielo: cuando un glaciar se agrieta y se parte en el mar, suena así."
  ],
  [
   47.97,
   50.09,
   "El monstruo era hielo."
  ],
  [
   50.09,
   53.62,
   "¿Qué otro sonido misterioso investigo? Comenta y sígueme."
  ]
 ],
