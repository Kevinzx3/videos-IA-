 "segmentos": [
  [
   0.0,
   5.72,
   "Barcos y aviones que desaparecen sin dejar rastro. ¿El Triángulo de las Bermudas es real?"
  ],
  [
   5.72,
   9.57,
   "Es una zona del Atlántico entre Miami, Bermudas y Puerto Rico."
  ],
  [
   9.57,
   16.25,
   "Y su fama es enorme: libros, documentales, teorías sobre la Atlántida, ovnis, portales…"
  ],
  [
   16.25,
   20.49,
   "Pero la agencia del océano de Estados Unidos, la NOAA, lo dice claro:"
  ],
  [
   20.49,
   25.29,
   "no hay pruebas de que ahí desaparezcan más barcos que en cualquier otra zona grande y transitada del océano."
  ],
  [
   25.29,
   30.98,
   "¿Y entonces? Por ahí pasan muchísimos barcos y aviones. Más tráfico, más accidentes."
  ],
  [
   30.98,
   36.27,
   "Además, la cruzan muchos huracanes, la corriente del Golfo es fuerte y hay zonas poco profundas."
  ],
  [
   36.27,
   40.5,
   "La Guardia Costera revisó casos y no encontró nada más que causas físicas."
  ],
  [
   40.5,
   45.27,
   "Ni siquiera es un nombre oficial: el gobierno estadounidense no lo reconoce en sus mapas."
  ],
  [
   45.27,
   46.59,
   "Ahora, el giro:"
  ],
  [
   46.59,
   52.15,
   "el nombre lo inventó un escritor en 1964, Vincent Gaddis, en un artículo de revista."
  ],
  [
   52.15,
   55.6,
   "O sea: el gran misterio empezó como un buen titular."
  ],
  [
   55.6,
   58.5,
   "¿Qué misterio investigo ahora? Comenta y sígueme."
  ]
 ],
