 "segmentos": [
  [
   0.0,
   4.79,
   "¿Los murciélagos son ciegos? Es uno de los mitos más famosos."
  ],
  [
   4.79,
   6.18,
   "Y es falso."
  ],
  [
   6.18,
   11.61,
   "No existe ninguna especie de murciélago ciega: todos tienen ojos y pueden ver."
  ],
  [
   11.61,
   17.11,
   "Muchos de los que comen insectos ven poco, pero se orientan con la ecolocalización:"
  ],
  [
   17.11,
   22.25,
   "lanzan chillidos agudísimos y escuchan el eco para saber dónde está cada cosa."
  ],
  [
   22.25,
   25.03,
   "Así cazan mosquitos en plena oscuridad."
  ],
  [
   25.03,
   31.23,
   "Y los murciélagos de la fruta, como los zorros voladores, tienen ojos grandes y ven muy bien de noche."
  ],
  [
   31.23,
   32.81,
   "Ahora, el giro:"
  ],
  [
   32.81,
   37.59,
   "algunos murciélagos ven incluso la luz ultravioleta, que para nosotros es invisible."
  ],
  [
   37.59,
   43.47,
   "Así que la próxima vez que alguien diga «ciego como un murciélago», ya sabes qué contestar."
  ],
  [
   43.47,
   47.44,
   "¿Qué otro mito quieres que desmonte? Comenta y sígueme."
  ]
 ],
