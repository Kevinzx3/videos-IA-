 "segmentos": [
  [
   0.0,
   4.48,
   "En un valle de Noruega aparecen luces en el cielo que nadie ha logrado explicar."
  ],
  [
   4.48,
   6.59,
   "Es el valle de Hessdalen."
  ],
  [
   6.59,
   12.68,
   "Bolas de luz blancas, amarillas o rojas, que flotan, se quedan quietas o salen disparadas."
  ],
  [
   12.68,
   18.77,
   "Se ven desde hace décadas, pero a principios de los ochenta hubo una oleada de avistamientos."
  ],
  [
   18.77,
   26.18,
   "Tantas, que en 1983 empezó el Proyecto Hessdalen para estudiarlas con cámaras y radares."
  ],
  [
   26.18,
   31.3,
   "Y desde 1998 una estación vigila el valle de forma automática."
  ],
  [
   31.3,
   34.84,
   "Hoy se ven unas diez o veinte veces al año."
  ],
  [
   34.84,
   36.33,
   "Ahora, el giro:"
  ],
  [
   36.33,
   42.81,
   "no es un mito: las luces se han fotografiado y medido. Lo que nadie sabe es qué son."
  ],
  [
   42.81,
   49.85,
   "Una hipótesis: aire y polvo cargados de electricidad por el radón del suelo, formando una especie de plasma."
  ],
  [
   49.85,
   52.79,
   "Pero ninguna teoría lo explica todo."
  ],
  [
   52.79,
   57.38,
   "¿Tú qué crees que son? Comenta y sígueme para más misterios."
  ]
 ],
