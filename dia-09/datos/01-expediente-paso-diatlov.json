 "segmentos": [
  [
   0.0,
   8.35,
   "Expediente Misterio número dos: nueve excursionistas huyeron de su tienda en plena noche… cortándola desde dentro."
  ],
  [
   8.35,
   14.56,
   "Fue en febrero de 1959, en los montes Urales, en la antigua Unión Soviética."
  ],
  [
   14.56,
   21.19,
   "Un grupo de estudiantes expertos, liderado por Ígor Diátlov, acampó en la ladera de una montaña nevada."
  ],
  [
   21.19,
   25.53,
   "Días después, los rescatistas encontraron la tienda rasgada desde dentro."
  ],
  [
   25.53,
   32.28,
   "Y huellas que bajaban por la nieve… muchas de gente descalza o en calcetines, a treinta grados bajo cero."
  ],
  [
   32.28,
   37.39,
   "Ninguno sobrevivió. Y algunos tenían lesiones muy graves, difíciles de explicar."
  ],
  [
   37.39,
   43.6,
   "Durante décadas hubo teorías de todo tipo: experimentos militares, ovnis, hasta un yeti."
  ],
  [
   43.6,
   45.08,
   "Ahora, el giro:"
  ],
  [
   45.08,
   52.8,
   "en 2021, dos científicos suizos publicaron una explicación que encaja muy bien: una avalancha de placa."
  ],
  [
   52.8,
   58.94,
   "Al cavar la ladera para la tienda, debilitaron la nieve, y horas después un bloque se deslizó sobre ellos."
  ],
  [
   58.94,
   63.83,
   "Pequeño, pero suficiente para que huyeran aterrados, sin tiempo de vestirse."
  ],
  [
   63.83,
   67.97,
   "Para muchos, el caso está cerrado. Para otros, todavía no."
  ],
  [
   67.97,
   72.0,
   "¿Tú qué crees? Comenta y sígueme para el siguiente expediente."
  ]
 ],
