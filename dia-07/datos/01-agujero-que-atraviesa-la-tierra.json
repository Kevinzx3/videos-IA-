{
 "id": "D07-V1",
 "titulo": "¿Y si caes por un agujero que atraviesa la Tierra?",
 "enfasis": [
  "atraviese",
  "aire",
  "centro",
  "bala",
  "frenarte",
  "instante",
  "treinta",
  "ocho",
  "siempre",
  "giro",
  "Índico",
