{
 "id": "D08-V1",
 "titulo": "¿Por qué los flamencos son rosas? Por lo que comen",
 "enfasis": [
  "grises",
  "color",
  "carotenoides",
  "zanahoria",
  "plumas",
  "rosa",
  "tres",
  "giro",
  "blancos",
  "maquillan",
