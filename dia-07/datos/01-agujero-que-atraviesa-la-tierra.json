 ],
 "segmentos": [
  [
   0.0,
   6.14,
   "Si cavaras un túnel que atraviese la Tierra y saltaras dentro, ¿cuánto tardarías en salir por el otro lado?"
  ],
  [
   6.14,
   10.47,
   "Imagina un tubo recto y sin aire, de lado a lado del planeta."
  ],
  [
   10.47,
   13.82,
   "Al saltar, la gravedad te acelera hacia el centro."
  ],
  [
   13.82,
   17.11,
   "Vas cada vez más rápido, mucho más que una bala."
  ],
  [
   17.11,
   20.18,
   "Al pasar el centro, la gravedad empieza a frenarte,"
  ],
  [
   20.18,
   25.07,
   "y llegas al otro lado quieto un instante, como una pelota en lo alto de su salto."
  ],
  [
   25.07,
   32.94,
   "¿El tiempo? Un físico lo calculó en 2015 con la densidad real de la Tierra: unos treinta y ocho minutos."
  ],
  [
   32.94,
   38.51,
   "Y si nadie te agarra, vuelves a caer, y te quedas yendo y viniendo para siempre."
  ],
  [
   38.51,
   40.08,
   "Ahora, el giro:"
  ],
  [
   40.08,
   47.25,
   "si saltaras desde el Caribe, no saldrías en China: saldrías en el océano Índico, cerca de Australia."
  ],
  [
   47.25,
   50.11,
   "Así que, antes de saltar, lleva flotador."
  ],
  [
   50.11,
   52.92,
   "¿Te atreverías? Comenta y sígueme."
  ]
 ],
