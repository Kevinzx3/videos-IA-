 "segmentos": [
  [
   0.0,
   4.42,
   "Un rayo es unas cinco veces más caliente que la superficie del Sol."
  ],
  [
   4.42,
   9.86,
   "No es una exageración: el aire por donde pasa puede llegar a unos treinta mil grados."
  ],
  [
   9.86,
   13.63,
   "La superficie del Sol ronda los cinco mil quinientos."
  ],
  [
   13.63,
   19.97,
   "Todo empieza dentro de las nubes de tormenta: el hielo y el agua chocan y se cargan de electricidad."
  ],
  [
   19.97,
   26.3,
   "Cuando la diferencia es enorme, la electricidad salta, y calienta el aire en una fracción de segundo."
  ],
  [
   26.3,
   32.16,
   "Ese aire se expande tan rápido que explota en una onda de sonido: eso es el trueno."
  ],
  [
   32.16,
   37.92,
   "Y como la luz viaja muchísimo más rápido que el sonido, siempre ves el rayo antes de oírlo."
  ],
  [
   37.92,
   43.9,
   "En todo el planeta caen unos cuarenta y cuatro rayos cada segundo, según los satélites de la NASA."
  ],
  [
   43.9,
   45.37,
   "Ahora, el giro:"
  ],
  [
   45.37,
   48.97,
   "el destello más brillante que ves no baja desde la nube."
  ],
  [
   48.97,
   55.17,
   "Primero baja una chispa débil, y cuando toca tierra, la descarga potente sube desde el suelo hacia la nube."
  ],
  [
   55.17,
   58.83,
   "O sea: el rayo que ves… en realidad va hacia arriba."
  ],
  [
   58.83,
   62.95,
   "¿Te ha caído un rayo cerca alguna vez? Comenta y sígueme."
  ]
 ],
